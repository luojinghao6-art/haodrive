# 个人兴趣爱好研究项目：用 Telegram 当存储可能违反其服务条款，账号有被封风险。详见 docs/RISK.md
# 你的域名（A 记录指向 VPS 公网 IP，Caddy 会自动申请 HTTPS 证书）
DOMAIN=drive.example.com

# 站点只在这个随机路径下响应，其它路径全部 404
# 生成：openssl rand -base64 18 | tr '+/' '-_' | tr -d '='
SECRET_PATH=change-me-to-a-random-path

# 网页登录密码，一定要改
ADMIN_PASSWORD=change-me-to-a-long-password

# 会话签名密钥，留空会在 data/secret.key 自动生成
APP_SECRET=

# 如果 VPS 上不了 Telegram，填代理，例如 socks5://user:pass@127.0.0.1:1080
PROXY=

# 逻辑文件上限（超过这个就拒收；默认 20GB）
MAX_UPLOAD_BYTES=21474836480

# 每片大小。留一点余量，保证服务端临时盘严格低于 2GB
TELEGRAM_PART_BYTES=1900000000

# 服务端 data/tmp 的硬上限。只对小于 10MB 的尾片和旧式上传生效；
# 大分片现在边收边发往 Telegram，不落盘
TMP_BUDGET_BYTES=2000000000

# 同时发往 Telegram 的 512KB 分块数（1-16）。越大越快，也越容易触发 FloodWait
UPLOAD_CONCURRENCY=4

# 浏览器与 Telegram 之间的内存缓冲（字节）。满了两边自然限速
UPLOAD_BUFFER_BYTES=33554432

# 全局上传限速，KB/s，0 = 不限速（网页设置页也能改）
UPLOAD_RATE_KBPS=0

# 仪表盘配额分母。Telegram 本身没有配额；0 = 不显示进度条
STORAGE_QUOTA_BYTES=0

# 媒体块缓存上限（视频拖动/重看走本地缓存）
MEDIA_CACHE_GB=2

# 打开视频/音频时提前填多少 MB 进缓存，越大越不容易卡（0 关闭）
PREBUFFER_MB=128

# WebDAV 用户名（密码首次启动自动生成，界面上可查看和重置）
WEBDAV_USER=haodrive

# 演示模式：不连 Telegram，用本地目录当网盘。生产环境保持 0
DEMO_MODE=0

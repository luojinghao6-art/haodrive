# 你的域名（A 记录指向 VPS 公网 IP，Caddy 会自动申请 HTTPS 证书）
DOMAIN=drive.example.com

# 站点只在这个随机路径下响应，其它路径全部 404
# 生成：openssl rand -base64 18 | tr '+/' '-_' | tr -d '='
SECRET_PATH=change-me-to-a-random-path

# 网页登录密码，一定要改
ADMIN_PASSWORD=change-me-to-a-long-password

# 会话签名密钥，留空会在 data/secret.key 自动生成
APP_SECRET=

# 如果 VPS 上不了 Telegram，填代理，例如 socks5://user:pass@127.0.0.1:1080
PROXY=

# 单个文件上限（默认 2GB，Telegram 的硬限制）
MAX_UPLOAD_BYTES=2147483648

# 媒体块缓存上限（视频拖动/重看走本地缓存）
MEDIA_CACHE_GB=4

# WebDAV 用户名（密码首次启动自动生成，界面上可查看和重置）
WEBDAV_USER=seagulldrive

# 演示模式：不连 Telegram，用本地目录当网盘。生产环境保持 0
DEMO_MODE=0
